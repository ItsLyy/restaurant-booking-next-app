# The canonical origin used for metadataBase, canonical URLs, sitemap.xml,
# and robots.txt. Must include the protocol and no trailing slash.
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Authentication ---

# Secret used to sign the JWT session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SESSION_SECRET=

# Canonical origin of the app. Used to build the Google OAuth redirect URI.
# Must include the protocol and no trailing slash.
AUTH_URL=http://localhost:3000

# Google OAuth 2.0 credentials. Create an OAuth client in Google Cloud
# Console (APIs & Services > Credentials > Create Credentials > OAuth client
# ID, application type "Web") and register this redirect URI:
#   {AUTH_URL}/api/auth/google/callback
# e.g. http://localhost:3000/api/auth/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=